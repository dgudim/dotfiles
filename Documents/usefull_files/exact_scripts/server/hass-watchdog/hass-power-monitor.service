[Unit]
Description=Hass UPS Monitor watchdog Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hass-power-monitor
ExecStart=/usr/bin/python3 /opt/hass-power-monitor/hass-power-monitor.py
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target

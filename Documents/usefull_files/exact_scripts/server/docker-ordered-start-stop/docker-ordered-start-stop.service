[Unit]
Description=Stop/start containers in order before Docker shuts down
After=docker.service
Requires=docker.service
# Also stop before / start after a `systemctl restart docker`
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/docker-ordered-start-stop/docker-ordered-start-stop start
ExecStop=/opt/docker-ordered-start-stop/docker-ordered-start-stop stop
TimeoutStartSec=10min
TimeoutStopSec=10min

[Install]
WantedBy=docker.service
